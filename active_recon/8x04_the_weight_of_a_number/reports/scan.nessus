        <description>The application backend is vulnerable to remote code execution via Log4j JNDI message lookups.</description>
        <cve>CVE-2021-44228</cve>
        <cvss3_vector>CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:C/C:H/I:H/A:H</cvss3_vector>
        <cvss3_base_score>10.0</cvss3_base_score>
        <cvss_base_score>9.3</cvss_base_score>
        <risk_factor>Critical</risk_factor>
        <plugin_output>A crafted ${jndi:ldap://...} payload in the X-Api-Version header triggered an outbound lookup.</plugin_output>
        <see_also>https://logging.apache.org/log4j/2.x/security.html</see_also>
