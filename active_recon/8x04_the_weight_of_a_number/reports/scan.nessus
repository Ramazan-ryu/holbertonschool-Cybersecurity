        <cvss4_vector>CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:H/VI:L/VA:N/SC:N/SI:N/SA:N</cvss4_vector>
        <cvss_base_score>8.8</cvss_base_score>
