        <description>Signing is not required on the remote SMB server, permitting man-in-the-middle attacks.</description>
        <cvss3_vector>CVSS:3.1/AV:A/AC:H/PR:N/UI:N/S:U/C:L/I:H/A:N</cvss3_vector>
        <cvss3_base_score>5.3</cvss3_base_score>
        <risk_factor>Medium</risk_factor>
        <plugin_output>Signing is enabled but not required by the SMB server.</plugin_output>
      </ReportItem>
      <ReportItem port="8080" svc_name="www" protocol="tcp" severity="4" pluginID="219"
                  pluginName="Exposed Application Debug/Actuator Endpoint" pluginFamily="Web Servers">
        <description>An unauthenticated diagnostic endpoint on the internal API exposes environment and configuration detail. Only this scanner reported it; it is a coverage gap for the other tools.</description>
