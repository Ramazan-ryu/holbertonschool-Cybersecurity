<?xml version="1.0" encoding="UTF-8"?>
<!-- Nessus network scan, Aurum Pay engagement. Provided input. Do NOT run or wrap Nessus. -->
<NessusClientData_v2>
  <Policy>
    <policyName>Aurum Pay - Internal Credentialed</policyName>
  </Policy>
  <Report name="Aurum Pay Estate" xmlns:cm="http://www.nessus.org/cm">

    <ReportHost name="10.20.3.12">
      <HostProperties>
        <tag name="host-ip">10.20.3.12</tag>
        <tag name="host-fqdn">db.aurumpay.example</tag>
        <tag name="operating-system">Ubuntu 22.04</tag>
        <tag name="netbios-name">DB-CDE-01</tag>
      </HostProperties>
      <ReportItem port="443" svc_name="https" protocol="tcp" severity="2" pluginID="118"
                  pluginName="TLS Library Weak Legacy Compatibility Mode" pluginFamily="General">
        <description>The database front-end TLS service accepts a weak legacy cryptographic compatibility mode. A diagnostics endpoint confirms the legacy parameter is honoured.</description>
        <cve>CVE-2022-0778</cve>
        <cvss4_vector>CVSS:4.0/AV:A/AC:H/AT:N/PR:N/UI:N/VC:H/VI:N/VA:N/SC:N/SI:N/SA:N</cvss4_vector>
        <cvss_base_score>6.5</cvss_base_score>
        <risk_factor>Medium</risk_factor>
        <plugin_output>The endpoint /api/diagnostics/tls-policy reports parameter legacy_mode accepted=true (weak cryptographic compatibility mode enabled).</plugin_output>
        <solution>Disable the legacy compatibility mode on the database TLS front end.</solution>
        <see_also>https://www.openssl.org/news/secadv/20220315.txt</see_also>
      </ReportItem>
      <ReportItem port="0" svc_name="general" protocol="tcp" severity="0" pluginID="19506"
                  pluginName="Nessus Scan Information" pluginFamily="Settings">
        <description>Information about the Nessus scan.</description>
        <plugin_output>Credentialed checks: yes. Scan policy: Internal Credentialed.</plugin_output>
        <risk_factor>None</risk_factor>
      </ReportItem>
    </ReportHost>

