{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Aurum Pay unified finding",
  "description": "Neutral schema the normaliser imposes on Nikto, OpenVAS and Nessus output. It carries no correlation, triage, verification or priority answer.",
  "type": "object",
  "required": ["id", "asset", "source", "severity", "confidence", "description"],
  "properties": {
    "id": {"type": "string", "description": "stable per-source finding id, e.g. F-NIK-014"},
    "asset": {"type": "string", "description": "asset as named by the scanner (hostname or IP)"},
    "asset_ip": {"type": ["string", "null"]},
    "port": {"type": ["integer", "null"]},
    "protocol": {"type": ["string", "null"]},
    "service": {"type": ["string", "null"]},
    "source": {"type": "string", "enum": ["nikto", "openvas", "nessus"]},
    "source_id": {"type": ["string", "null"], "description": "the scanner-native id (OSVDB, OID, plugin id)"},
    "title": {"type": ["string", "null"]},
    "description": {"type": "string"},
    "severity": {"type": "string", "enum": ["info", "low", "medium", "high", "critical"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "cve": {"type": "array", "items": {"type": "string"}},
    "location": {"type": ["string", "null"], "description": "resource path or endpoint a verifier could probe, when the scanner reported one"},
    "cvss": {
      "type": ["object", "null"],
      "properties": {
        "version": {"type": "string", "enum": ["3.1", "4.0"]},
        "vector": {"type": "string"},
        "base_score": {"type": "number"}
      }
    },
    "references": {"type": "array", "items": {"type": "string"}}
  }
}
